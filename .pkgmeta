package-as: WhatsAHanzi

ignore:
  - tests
  - .github
  - .luacheckrc
  - .stylua.toml
  - .busted
  - CHANGELOG.md
  - docs
  # The companion app's file: other people's chat, written on this PC only. The example documents the shape.
  - Data/Local.lua
  - Data/Local.example.lua
  # The word sound bank and its index: built on this PC by the companion, never shipped.
  - Sounds/words
  - Data/SoundIndex.lua
  - Data/SoundIndex.example.lua
  # The Forever client refuses addon font files (README "Fonts"): keep the 10 MB Noto subset in the repo,
  # out of the release zip, until a client build accepts it. Font.detect() records the missing file as refused.
  - Fonts/NotoSansSC-Regular.ttf
  - LICENSES/OFL-NotoSansSC.txt
  # The 9.7 MB syllable bank stays out of the release zip until selftest.soundProbe shows the client plays
  # addon .ogg files (the same client refuses addon fonts). Sound.probe() records a refusal.
  - Sounds
  - LICENSES/KOKORO-NOTICE.txt

# externals: none yet (LibStub/Ace3 would go here)
